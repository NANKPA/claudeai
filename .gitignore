# Scraped third-party full text (transcripts, lessons, show notes) stays local by default.
# Delete these lines if you want to commit your scraped corpus to a private repo.
trading-intelligence/*/raw/**
!trading-intelligence/*/raw/.gitkeep

# Build output (regenerate with tools/bundle_for_claude.py)
dist/

# Python / graphify caches
__pycache__/
*.pyc
graphify-out/
.graphify*

# Local search-result caches used to re-rank the top-100 lists
*.candidates.json

# Market data cached by tools/philosophy/studies.py (re-download with --refresh)
tools/philosophy/data/

# Hand-off archive of git-ignored local data (see HANDOFF.md)
claudeai-local-data.tar.gz

# Python packaging
*.egg-info/
build/

# Sniper lab: per-trade backtest log (regenerate with `python -m trading_intelligence.sniper lab`)
trading-intelligence/10_sniper-lab/backtests/trades.csv.gz
trading-intelligence/10_sniper-lab/backtests/*/jobs/
trading-intelligence/10_sniper-lab/backtests/jobs/
trading-intelligence/10_sniper-lab/backtests/*/trades.csv.gz
# Sniper lab: partial grids (combined into backtests/ by `lab --from-trades --inputs ...`)
trading-intelligence/10_sniper-lab/backtests/crypto/
trading-intelligence/10_sniper-lab/backtests/fx/
trading-intelligence/10_sniper-lab/backtests/backtest-report.md
trading-intelligence/10_sniper-lab/backtests/setups.yaml
